# Matplotlib style for scientific plotting
# This is the base style for "SciencePlots"
# see: https://github.com/garrettj403/SciencePlots
# **Edited by Dominic Taylor**
# Store within the .matplotlib/stylelib directory. If doesn't exist, create it.
# To use, do NOT import scienceplots. Just execute "plt.style.use('science')".

# Set color cycle: blue, green, yellow, red, violet, gray
axes.prop_cycle : cycler('color', ['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747', '9e9e9e'])
# axes.prop_cycle: cycler('color', ['0077BB','33BBEE', '009988', 'EE7733', 'CC3311', 'EE3377', 'BBBBBB'])
# axes.prop_cycle: cycler('color', ['02C5FC','D93425','C0B73E','532AD4','AE2AD4','F0690E']) #new
# axes.prop_cycle: cycler('color', ['045275','089099','7CCBA2','FCDE9C','F0746E','DC3977','7C1D6F'])
# axes.prop_cycle: cycler('color', ['deep red','red','coral','pastel red','pinkish orange','blush','light rose'])
# axes.prop_cycle: cycler('color', ['9a0200','e50000','fc5a50','db5856','ff724c','f29e8e','ffc5cb'])

# Set default figure size
# figure.figsize : 6, 6.5
figure.figsize : 3.2, 2.6

# Use serif fonts
font.family : sans-serif
font.sans-serif : Helvetica
#
# font.serif : Times
# font.family : serif
# font.serif : Times New Roman
# xtick.font.serif : Helvetica
# ytick.font.serif : Helvetica
# font.sans-serif : Courier
# font.family : monospace
# font.monospace: Courier New
# font.weight : bold
# mathtext.fontset : dejavuserif
mathtext.fontset: stix
# mathtext.fontset: stixsans

# Set fontsize
font.size: 12
legend.fontsize: 10

# Set x axis
xtick.direction : in
xtick.major.size : 5
xtick.major.width : 0.7
xtick.minor.size : 3
xtick.minor.width : 0.7
xtick.minor.visible : True
xtick.top : True

# Set y axis
ytick.direction : in
ytick.major.size : 5
ytick.major.width : 0.7
ytick.minor.size : 3
ytick.minor.width : 0.7
ytick.minor.visible : True
ytick.right : True

# Set capsize
errorbar.capsize: 1.5

# Set line widths
# axes.linewidth : 0.5
# grid.linewidth : 0.5
# lines.linewidth : 1.
# axes.linewidth: 0.6
# grid.linewidth: 0.6
# lines.linewidth: 1.
axes.linewidth: 0.7
grid.linewidth: 0.7
lines.linewidth: 1.3

# Remove legend frame
legend.frameon : False

# Set image colormap
image.cmap : inferno

# Always save as 'tight'
savefig.bbox : tight
savefig.pad_inches : 0.05

# Use LaTeX for math formatting
# text.usetex : True
text.latex.preamble : \usepackage{amsmath} \usepackage{amssymb}
